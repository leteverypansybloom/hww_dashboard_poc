__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
build/
*.egg-info/

# Pipeline output. On a working laptop it holds real organisation names
# and survey answers, so it is never committed. Rebuild the demo tables
# with: python wrangle.py tests/data/config.toml
output/
# Temporary folders the pipeline stages outputs in (kept only if
# restoring a previous output folder fails).
.hww-*/

# Run logs: they can hold the details of an unexpected error.
logs/
*.log

# Local settings that may point at real data or hold credentials.
*.local.toml
.env
.env.*

# Coverage reports.
.coverage
coverage.xml
htmlcov/
