config {
  type: "table",
  description: "WAS database: one row per support request with an organisation (R40, R41)",
  assertions: {
    uniqueKey: ["was_request_id"],
    nonNull: ["org", "employer_id"]
  },
  columns: {
    was_request_id: "R40: WAS- and the Participant ID, or WAS-row and the Excel row when it is blank",
    row_number: "Excel row number",
    participant_id_blank: "The Participant ID is blank",
    org: "R60: tidied organisation name, after overrides",
    name_key: "R60: the name's key",
    employer_id: "R64: the organisation's employer id",
    enquiry_date: "R41: Date of Enquiry, or the allocation date when it is blank",
    used_fallback_date: "The enquiry date is blank, so the allocation date was used"
  }
}

js {
  const w = hww.WAS;
}

WITH loaded AS ${hww.latestRows("was", ref("hww_was"), ref("raw_latest_loads"))},

cells AS (
  SELECT
    row_number,
    ${hww.clean(w.id)} AS id_text,
    ${hww.clean(w.org)} AS org_text,
    ${hww.date(w.enquiryDate)} AS enquiry,
    ${hww.date(w.fallbackEnquiryDate)} AS fallback,
    ${hww.clean(w.size)} AS size_text,
    ${hww.clean(w.sector)} AS sector_text,
    ${hww.clean(w.industry)} AS industry_text,
    ${hww.clean(w.sites)} AS sites_text
  FROM loaded
  -- R06: a row whose every loaded cell is blank.
  WHERE ${hww.anyValue(w.loaded)}
),

named AS (
  SELECT
    cells.*,
    COALESCE(overrides.canonical_name, cells.org_text) AS org
  FROM cells
  LEFT JOIN ${ref("ref_org_overrides_resolved")} AS overrides
    ON overrides.name_key = ${hww.nameKey("cells.org_text")}
)

SELECT
  CONCAT('WAS-', COALESCE(id_text, CONCAT('row', CAST(row_number AS STRING)))) AS was_request_id,
  row_number,
  id_text IS NULL AS participant_id_blank,
  org,
  ${hww.nameKey("org")} AS name_key,
  ${hww.employerId(hww.nameKey("org"))} AS employer_id,
  COALESCE(enquiry, fallback) AS enquiry_date,
  enquiry IS NULL AS used_fallback_date,
  sector_text,
  ${hww.band("sector_map")} AS sector,
  industry_text,
  ${hww.band("industry_map")} AS industry,
  size_text,
  ${hww.band("size_map")} AS size_band,
  sites_text,
  ${hww.band("sites_map")} AS sites_band
FROM named
LEFT JOIN ${ref("ref_lookups")} AS sector_map
  ON sector_map.dimension = 'sector' AND sector_map.raw_key = LOWER(sector_text)
LEFT JOIN ${ref("ref_lookups")} AS industry_map
  ON industry_map.dimension = 'industry' AND industry_map.raw_key = LOWER(industry_text)
LEFT JOIN ${ref("ref_lookups")} AS size_map
  ON size_map.dimension = 'size_band' AND size_map.raw_key = LOWER(size_text)
LEFT JOIN ${ref("ref_lookups")} AS sites_map
  ON sites_map.dimension = 'sites_band' AND sites_map.raw_key = LOWER(sites_text)
WHERE org IS NOT NULL
